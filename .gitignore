# ---- data & experiment outputs (large, not tracked) ----
data/
exp/
logs/
*.laz
*.las
*.ply
*.pcap
*.pth
*.npy
*.npz

# ---- generated figures / docs (regenerated by scripts) ----
notes/figs/
notes/report_figures/
notes/slides_png/
*.pdf
*.log

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.DS_Store

# keep assets/ (curated README images) tracked
!assets/

# generated report artifacts (broken refs on GitHub)
*.html
notes/report_en2.md

# ---- drafts / internal (not for the public repo) ----
notes/
paper/
scripts/*.png
scripts/_*.sh
